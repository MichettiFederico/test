<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Visor de Backtests BTC 60x</title>
<style>
:root{--bg:#0f1115;--card:#171a21;--bd:#262b36;--tx:#e6e8ee;--mu:#8b93a7;--ac:#4f8cff;--up:#22c55e;--dn:#ef4444}
@media (prefers-color-scheme:light){:root{--bg:#f6f7fb;--card:#fff;--bd:#e2e5ee;--tx:#1b1f2a;--mu:#6b7385;--ac:#2563eb;--up:#16a34a;--dn:#dc2626}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;padding:16px;max-width:1200px;margin-inline:auto}
h1{font-size:20px;margin:4px 0}
h2{font-size:15px;margin:0 0 10px}
.mu{color:var(--mu)}.small{font-size:12.5px}
code{background:var(--card);border:1px solid var(--bd);padding:1px 5px;border-radius:5px}
.up{color:var(--up)}.dn{color:var(--dn)}
.drop{display:flex;flex-direction:column;align-items:center;gap:4px;border:2px dashed var(--bd);border-radius:14px;padding:28px 16px;margin:16px 0;cursor:pointer;text-align:center;background:var(--card)}
.drop.over{border-color:var(--ac)}
.drop span{color:var(--mu);font-size:13px}
.err{background:color-mix(in srgb,var(--dn) 15%,transparent);border:1px solid var(--dn);padding:10px 12px;border-radius:10px;margin-bottom:12px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:14px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px}
.kpi .l{font-size:12px;color:var(--mu)}.kpi .v{font-size:21px;font-weight:650}.kpi .s{font-size:12px;color:var(--mu)}
.filters{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:14px}
.filters label{display:flex;gap:6px;align-items:center;font-size:13px}
select,input[type=number],button{background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:8px;padding:6px 9px;font:inherit}
input[type=number]{width:80px}
button{cursor:pointer}button:hover{border-color:var(--ac)}
.grid2{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:800px){.grid2{grid-template-columns:1fr 1fr}}
canvas{width:100%;height:260px;display:block}
.scroll{overflow:auto;max-height:560px}
table{border-collapse:collapse;width:100%;font-size:13px;white-space:nowrap}
th,td{padding:6px 9px;border-bottom:1px solid var(--bd);text-align:right}
th:nth-child(2),td:nth-child(2),#fam th:first-child,#fam td:first-child{text-align:left}
th{position:sticky;top:0;background:var(--card);cursor:pointer;color:var(--mu);font-weight:600;user-select:none}
#fam th{cursor:default;position:static}
tr:hover td{background:color-mix(in srgb,var(--ac) 8%,transparent)}
.note{border-left:3px solid var(--ac);padding:6px 10px;margin:10px 0;font-size:13px;color:var(--mu)}
</style>
</head>
<body>
<h1>Visor de backtests · BTC perp 60x</h1>
<p class="mu small">Cargá el <code>results.json</code> que genera <code>backtest_btc_60x.py</code>. Todo se procesa en tu navegador, no se sube nada.</p>

<label id="drop" class="drop">
  <input type="file" id="file" accept=".json,application/json" hidden>
  <b>Tocá para elegir results.json</b><span>o arrastralo acá</span>
</label>
<div id="err" class="err" hidden></div>

<main id="app" hidden>
  <div class="filters">
    <label>Tipo
      <select id="fFam"><option value="">Todos</option><option value="ema">EMA</option><option value="rsi">RSI</option><option value="donch">Donchian</option></select>
    </label>
    <label>Mín. trades <input type="number" id="fTr" value="30" min="0"></label>
    <label><input type="checkbox" id="fBoth"> Positivas en train y test</label>
    <label><input type="checkbox" id="fLiq"> Sin liquidaciones en test</label>
    <button id="csv">Exportar CSV</button>
  </div>

  <section class="cards" id="cards"></section>

  <div class="note">Ordenar por resultado en test sirve para diagnosticar cuánto se degrada la estrategia, no para elegir: si elegís la mejor en test, volvés a seleccionar sobre datos mirados y el sesgo vuelve a entrar.</div>

  <section class="grid2">
    <div class="card"><h2>Train vs Test (cada punto = 1 estrategia)</h2><canvas id="sc"></canvas>
      <p class="mu small">Con edge real la nube sigue la diagonal punteada. Si en test se aplasta alrededor de 0 o por debajo, el train era ruido.</p>
      <p class="small" id="leg"></p></div>
    <div class="card"><h2>Distribución del retorno en test</h2><canvas id="hi"></canvas></div>
  </section>

  <section class="card"><h2>Por tipo de estrategia</h2><div class="scroll"><table id="fam"></table></div></section>

  <section class="card"><h2>Todas las estrategias <span class="mu" id="cnt"></span></h2>
    <p class="mu small">Click en un encabezado para ordenar. # = ranking en train (1 = mejor en train).</p>
    <div class="scroll"><table id="tbl"></table></div></section>
</main>

<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const pct=(x,d=1)=>(x*100).toFixed(d)+'%';
const cls=x=>x>0?'up':x<0?'dn':'';
const med=a=>{if(!a.length)return 0;const s=[...a].sort((x,y)=>x-y),m=s.length>>1;return s.length%2?s[m]:(s[m-1]+s[m])/2};
const avg=a=>a.length?a.reduce((x,y)=>x+y,0)/a.length:0;
const FAM={ema:'EMA',rsi:'RSI',donch:'Donchian'};
const COL={ema:'#4f8cff',rsi:'#f59e0b',donch:'#a855f7'};
let ALL=[],VIEW=[],META={},sortIdx=0,sortDir=1;

function pstr(p){
  let s=p.fam==='ema'?`EMA ${p.fast}/${p.slow}`:p.fam==='rsi'?`RSI${p.n} ${p.lo}/${p.hi}`:`Donchian ${p.n}`;
  return `${s} · SL ${(p.sl*100).toFixed(2)}% · RR ${p.rr} · ${p.maxbars}v`;
}
const COLS=[
 {l:'#',v:r=>r.id,f:r=>r.id},
 {l:'Parámetros',v:r=>pstr(r.params),f:r=>esc(pstr(r.params))},
 {l:'Ret train',v:r=>r.train.ret,f:r=>`<span class="${cls(r.train.ret)}">${pct(r.train.ret)}</span>`},
 {l:'DD train',v:r=>r.train.mdd,f:r=>pct(r.train.mdd)},
 {l:'Ret test',v:r=>r.test.ret,f:r=>`<span class="${cls(r.test.ret)}">${pct(r.test.ret)}</span>`},
 {l:'DD test',v:r=>r.test.mdd,f:r=>pct(r.test.mdd)},
 {l:'Trades tr/te',v:r=>r.test.trades,f:r=>`${r.train.trades}/${r.test.trades}`},
 {l:'Win% test',v:r=>r.test.winrate,f:r=>pct(r.test.winrate,0)},
 {l:'Liq. test',v:r=>r.test.liqs,f:r=>r.test.liqs?`<span class="dn">${r.test.liqs}</span>`:'0'}
];

// ---- carga ----
function load(file){
  const rd=new FileReader();
  rd.onload=()=>{
    try{
      const d=JSON.parse(rd.result);
      const arr=Array.isArray(d)?d:d.results;
      if(!Array.isArray(arr)||!arr.length||!arr[0].train||!arr[0].test) throw new Error('El archivo no tiene el formato de results.json del script.');
      ALL=arr; META=d.meta||{};
      $('#err').hidden=true; $('#app').hidden=false; apply();
    }catch(e){$('#err').textContent='No pude leer el archivo: '+e.message;$('#err').hidden=false;$('#app').hidden=true;}
  };
  rd.readAsText(file);
}
$('#file').addEventListener('change',e=>e.target.files[0]&&load(e.target.files[0]));
const dz=$('#drop');
['dragenter','dragover'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.add('over')}));
['dragleave','drop'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.remove('over')}));
dz.addEventListener('drop',e=>e.dataTransfer.files[0]&&load(e.dataTransfer.files[0]));
['fFam','fTr','fBoth','fLiq'].forEach(id=>$('#'+id).addEventListener('input',apply));
$('#csv').addEventListener('click',exportCsv);
window.addEventListener('resize',()=>{if(ALL.length){scatter();hist();}});

// ---- filtros y render ----
function apply(){
  const fam=$('#fFam').value,mt=+$('#fTr').value||0,both=$('#fBoth').checked,nl=$('#fLiq').checked;
  VIEW=ALL.filter(r=>(!fam||r.params.fam===fam)&&r.test.trades>=mt&&(!both||(r.train.ret>0&&r.test.ret>0))&&(!nl||r.test.liqs===0));
  cards();scatter();hist();famTable();table();
}
function kpi(l,v,s='',c=''){return `<div class="kpi"><div class="l">${l}</div><div class="v ${c}">${v}</div><div class="s">${s}</div></div>`}
function cards(){
  const n=VIEW.length,N=n||1;
  const pt=VIEW.filter(r=>r.train.ret>0).length,pe=VIEW.filter(r=>r.test.ret>0).length,pb=VIEW.filter(r=>r.train.ret>0&&r.test.ret>0).length;
  const mtr=med(VIEW.map(r=>r.train.ret)),mte=med(VIEW.map(r=>r.test.ret));
  const blown=VIEW.filter(r=>r.test.ret<=-0.99).length;
  const liqs=VIEW.reduce((a,r)=>a+r.test.liqs,0);
  $('#cards').innerHTML=
    kpi('Estrategias',n,`de ${ALL.length} · ${META.tf||''} ${META.lev?META.lev+'x':''}`)+
    kpi('Positivas en train',pct(pt/N,0),`${pt} de ${n}`)+
    kpi('Positivas en test',pct(pe/N,0),`${pe} de ${n}`,pe/N<0.5?'dn':'up')+
    kpi('Positivas en ambas',pct(pb/N,0),`${pb} de ${n}`)+
    kpi('Mediana ret. train',pct(mtr),'',cls(mtr))+
    kpi('Mediana ret. test',pct(mte),'',cls(mte))+
    kpi('DD mediano test',pct(med(VIEW.map(r=>r.test.mdd))))+
    kpi('Cuenta quebrada (test)',pct(blown/N,0),`${blown} estrategias`,blown?'dn':'')+
    kpi('Liquidaciones (test)',liqs,'total entre todas',liqs?'dn':'');
  $('#cnt').textContent=`(${n})`;
}

// ---- gráficos ----
function setup(c){const r=c.getBoundingClientRect(),d=window.devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;const x=c.getContext('2d');x.setTransform(d,0,0,d,0,0);return{x,w:r.width,h:r.height}}
const cv=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
function scatter(){
  const {x,w,h}=setup($('#sc')),P={l:44,r:10,t:8,b:30};
  x.clearRect(0,0,w,h);
  if(!VIEW.length){x.fillStyle=cv('--mu');x.fillText('Sin datos con estos filtros',20,30);return}
  const xs=VIEW.map(r=>r.train.ret),ys=VIEW.map(r=>r.test.ret);
  const lo=Math.min(0,...xs,...ys),hi=Math.max(0.01,...xs,...ys),pad=(hi-lo)*0.05;
  const a=lo-pad,b=hi+pad;
  const X=v=>P.l+(v-a)/(b-a)*(w-P.l-P.r),Y=v=>h-P.b-(v-a)/(b-a)*(h-P.t-P.b);
  x.strokeStyle=cv('--bd');x.fillStyle=cv('--mu');x.font='11px system-ui';x.lineWidth=1;
  x.beginPath();x.moveTo(X(a),Y(0));x.lineTo(X(b),Y(0));x.moveTo(X(0),Y(a));x.lineTo(X(0),Y(b));x.stroke();
  x.setLineDash([4,4]);x.beginPath();x.moveTo(X(a),Y(a));x.lineTo(X(b),Y(b));x.stroke();x.setLineDash([]);
  x.textAlign='center';[a+pad,0,b-pad].forEach(v=>x.fillText(pct(v,0),X(v),h-14));
  x.textAlign='right';[a+pad,0,b-pad].forEach(v=>x.fillText(pct(v,0),P.l-4,Y(v)+4));
  x.textAlign='center';x.fillText('retorno train',(w+P.l)/2,h-1);
  VIEW.forEach(r=>{x.fillStyle=COL[r.params.fam]+'99';x.beginPath();x.arc(X(r.train.ret),Y(r.test.ret),3,0,7);x.fill()});
  $('#leg').innerHTML=Object.keys(FAM).map(k=>`<span style="color:${COL[k]}">●</span> ${FAM[k]}`).join(' &nbsp; ')+' &nbsp; <span class="mu">(eje Y = retorno test)</span>';
}
function hist(){
  const {x,w,h}=setup($('#hi')),P={l:34,r:10,t:8,b:30};
  x.clearRect(0,0,w,h);
  if(!VIEW.length)return;
  const v=VIEW.map(r=>r.test.ret),lo=Math.min(...v),hi=Math.max(...v,lo+0.01),B=24,bw=(hi-lo)/B;
  const bins=Array(B).fill(0);v.forEach(t=>bins[Math.min(B-1,Math.floor((t-lo)/bw))]++);
  const mx=Math.max(...bins),cw=(w-P.l-P.r)/B;
  bins.forEach((c,i)=>{const mid=lo+(i+0.5)*bw;x.fillStyle=mid>=0?cv('--up'):cv('--dn');const bh=c/mx*(h-P.t-P.b);x.fillRect(P.l+i*cw+1,h-P.b-bh,cw-2,bh)});
  x.fillStyle=cv('--mu');x.font='11px system-ui';x.textAlign='center';
  [lo,0,hi].forEach(t=>{if(t>=lo&&t<=hi)x.fillText(pct(t,0),P.l+(t-lo)/(hi-lo)*(w-P.l-P.r),h-14)});
  x.fillText('retorno en test',(w+P.l)/2,h-1);x.textAlign='right';x.fillText(mx,P.l-4,P.t+10);
  if(lo<0&&hi>0){const z=P.l+(0-lo)/(hi-lo)*(w-P.l-P.r);x.strokeStyle=cv('--mu');x.beginPath();x.moveTo(z,P.t);x.lineTo(z,h-P.b);x.stroke()}
}

// ---- tablas ----
function famTable(){
  const rows=Object.keys(FAM).map(k=>{
    const s=VIEW.filter(r=>r.params.fam===k);if(!s.length)return '';
    const n=s.length;
    return `<tr><td>${FAM[k]}</td><td>${n}</td><td>${pct(s.filter(r=>r.train.ret>0).length/n,0)}</td><td>${pct(s.filter(r=>r.test.ret>0).length/n,0)}</td>
    <td class="${cls(med(s.map(r=>r.train.ret)))}">${pct(med(s.map(r=>r.train.ret)))}</td><td class="${cls(med(s.map(r=>r.test.ret)))}">${pct(med(s.map(r=>r.test.ret)))}</td>
    <td>${pct(avg(s.map(r=>r.test.mdd)),0)}</td><td>${s.reduce((a,r)=>a+r.test.liqs,0)}</td></tr>`}).join('');
  $('#fam').innerHTML=`<tr><th>Tipo</th><th>N</th><th>% pos. train</th><th>% pos. test</th><th>Med. ret train</th><th>Med. ret test</th><th>DD prom. test</th><th>Liq. test</th></tr>`+rows;
}
function table(){
  const c=COLS[sortIdx];
  const rows=[...VIEW].sort((p,q)=>{const a=c.v(p),b=c.v(q);return (a>b?1:a<b?-1:0)*sortDir});
  $('#tbl').innerHTML='<tr>'+COLS.map((k,i)=>`<th data-i="${i}">${k.l}${i===sortIdx?(sortDir>0?' ▲':' ▼'):''}</th>`).join('')+'</tr>'+
    rows.map(r=>'<tr>'+COLS.map(k=>`<td>${k.f(r)}</td>`).join('')+'</tr>').join('');
  $('#tbl').querySelectorAll('th').forEach(th=>th.onclick=()=>{const i=+th.dataset.i;sortDir=(i===sortIdx)?-sortDir:-1;if(i===0||i===1)sortDir=1;sortIdx=i;table()});
}
function exportCsv(){
  const h='id,tipo,parametros,train_ret,train_dd,train_trades,train_winrate,train_liqs,test_ret,test_dd,test_trades,test_winrate,test_liqs';
  const l=VIEW.map(r=>[r.id,r.params.fam,'"'+pstr(r.params)+'"',r.train.ret,r.train.mdd,r.train.trades,r.train.winrate,r.train.liqs,r.test.ret,r.test.mdd,r.test.trades,r.test.winrate,r.test.liqs].join(','));
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([h+'\n'+l.join('\n')],{type:'text/csv'}));a.download='backtests_filtrados.csv';a.click();
}
</script>
</body>
</html>
